# Deduxis: environment variables. Copy to .env.local for local dev;
# set the same names in Vercel → Settings → Environment Variables. Never commit real values.

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Supabase anon/publishable key (browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project URL (browser).
NEXT_PUBLIC_SUPABASE_URL=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_APP_URL=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# --- Read by the code but missing above (added 2026-10-02) ---
APIXIS_CLIENT_ID=deduxis
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# optional; defaults to https://apixis.dev
APIXIS_WORLD_API=
# this site's Apixis world key; its SHA-256 is listed in APIXIS_WORLD_KEYS on apixis.dev
APIXIS_WORLD_KEY=
# sender address for email
EMAIL_FROM=
# this site's public URL
NEXT_PUBLIC_SITE_URL=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# email (support, notifications)
RESEND_API_KEY=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=
# Supabase service role key (server only). Required to write purchase receipts from Stripe webhooks and Ixis redeems.
SUPABASE_SERVICE_ROLE_KEY=
# where support messages go
SUPPORT_ROUTE_TO=

# --- Card checkout (Apixis Dev LLC Stripe account, test mode until launch) ---
# Server only. Prefer a restricted key (rk_). Never commit a real value.
# One Product and one monthly Price per plan, created in that Stripe account.
# The app tags Checkout and the subscription with metadata product=deduxis.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RECEIPTS_PERSONAL=
STRIPE_PRICE_RECEIPTS_BUSINESS=
STRIPE_PRICE_MONITOR=
